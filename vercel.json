{
  "version": 2,
  "builds": [
    {
      "src": "app1e/api/index.php",
      "use": "vercel-php@0.7.1",
      "config": {
        "includeFiles": [
          "app1e/api/apple2k26/**"
        ]
      }
    },
    {
      "src": "app1e/api/apple2k26/res/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/res/(.*)",
      "dest": "/app1e/api/apple2k26/res/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/app1e/api/index.php"
    }
  ]
}
